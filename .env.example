# Copy to .env (git-ignored) and adjust. Variables set in the process environment win over .env.
DEBUG=True
# Development-only key; generate a new one for anything that is not local.
SECRET_KEY=django-insecure-local-development-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://openspec20261104:openspec@localhost:5432/openspec20261104

# --- Production (docker compose) ---
# On the server, create .env with these (docker compose reads it from the project directory).
# DEBUG and DATABASE_URL above are ignored there: compose sets them itself.
# Generate secrets with `openssl rand -hex 32` (hex only: the password is placed in a URL).
# SECRET_KEY=
# ALLOWED_HOSTS=example.com
# POSTGRES_PASSWORD=
# Optional: host port (default 80) and gunicorn workers (default 3).
# APP_PORT=80
# WEB_CONCURRENCY=3
